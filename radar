local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local lp = Players.LocalPlayer

local SIZE, range, on, acc, angle = 240, 500, false, 0, 0
local R = SIZE / 2
local function drawGengarFace(parent, w, h, anchor, pos)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = pos
	f.Size = UDim2.fromOffset(w, h)
	f.Parent = parent
	local function box(x, y, bw, bh, col, rot, z, corner)
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(x, 0, y, 0)
		b.Size = UDim2.new(bw, 0, bh, 0)
		b.BackgroundColor3 = col
		b.BorderSizePixel = 0
		b.Rotation = rot or 0
		b.ZIndex = z or 2
		b.Parent = f
		if corner then local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(corner, 0); c.Parent = b end
		return b
	end
	local BLACK, WHITE, EDGE = Color3.fromRGB(14, 8, 22), Color3.fromRGB(250, 250, 250), Color3.fromRGB(110, 66, 170)
	local sq = h / w
	for _, x in ipairs({0.1, 0.9}) do
		local e = box(x, 0.2, 0.17, 0.17 / sq, BLACK, 45, 1)
		local s = Instance.new("UIStroke"); s.Color = EDGE; s.Thickness = 1; s.Parent = e
	end
	box(0.5, 0.1, 0.12, 0.12 / sq, BLACK, 45, 1)
	local head = box(0.5, 0.58, 0.96, 0.82, BLACK, 0, 2, 0.28)
	local hs = Instance.new("UIStroke"); hs.Color = EDGE; hs.Thickness = 1; hs.Parent = head
	for _, d in ipairs({{0.29, 14}, {0.71, -14}}) do
		box(d[1], 0.36, 0.28, 0.2, WHITE, d[2], 4, 0.3)
		box(d[1], 0.36, 0.03, 0.17, BLACK, 0, 5)
	end
	box(0.5, 0.74, 0.8, 0.3, WHITE, 0, 3, 0.25)
	for i = 1, 5 do box(0.1 + i * 0.133, 0.74, 0.012, 0.3, BLACK, 0, 4) end
	box(0.5, 0.74, 0.8, 0.03, BLACK, 0, 4)
	return f
end
local GENGAR_IMAGE = "" -- pega aqui el id de tu imagen, por ejemplo "rbxassetid://123456789" (PNG con fondo transparente)
local TOP = 160

local BG, RING = Color3.fromRGB(22, 14, 34), Color3.fromRGB(70, 42, 112)
local LINE, TXT = Color3.fromRGB(110, 66, 170), Color3.fromRGB(236, 226, 255)
local PANEL, EYE = Color3.fromRGB(34, 22, 54), Color3.fromRGB(230, 40, 72)

local env = getgenv and getgenv() or _G
if env.GengarRadarCleanup then pcall(env.GengarRadarCleanup) end
local conns = {}

local okHui, hui = pcall(function() return gethui and gethui() end)
local parent = (okHui and hui) or lp:WaitForChild("PlayerGui")
local old = parent:FindFirstChild("GengarRadarUI")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "GengarRadarUI"; gui.ResetOnSpawn = false; gui.DisplayOrder = 997
gui.Parent = parent

local disc = Instance.new("Frame", gui)
disc.Size = UDim2.fromOffset(SIZE, SIZE); disc.Position = UDim2.new(0, 20, 0, TOP)
disc.BackgroundColor3 = BG; disc.ClipsDescendants = true; disc.Visible = false
Instance.new("UICorner", disc).CornerRadius = UDim.new(1, 0)
local stroke = Instance.new("UIStroke", disc)
stroke.Color = LINE; stroke.Thickness = 2

local function ring(frac)
	local r = Instance.new("Frame", disc)
	r.AnchorPoint = Vector2.new(0.5, 0.5); r.Position = UDim2.fromScale(0.5, 0.5)
	r.Size = UDim2.fromScale(frac, frac); r.BackgroundTransparency = 1
	Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)
	local st = Instance.new("UIStroke", r)
	st.Color = RING; st.Thickness = 1
end
for _, fr in ipairs({ 0.33, 0.66, 0.98 }) do ring(fr) end
for _, sz in ipairs({ UDim2.new(1, 0, 0, 1), UDim2.new(0, 1, 1, 0) }) do
	local l = Instance.new("Frame", disc)
	l.AnchorPoint = Vector2.new(0.5, 0.5); l.Position = UDim2.fromScale(0.5, 0.5)
	l.Size = sz; l.BorderSizePixel = 0; l.BackgroundColor3 = RING
end

-- barrido rojo, como la mirada de Gengar
local sweep = Instance.new("Frame", disc)
sweep.AnchorPoint = Vector2.new(0, 0.5); sweep.Position = UDim2.fromScale(0.5, 0.5)
sweep.Size = UDim2.new(0, R, 0, 2); sweep.BorderSizePixel = 0
sweep.BackgroundColor3 = EYE; sweep.BackgroundTransparency = 0.35; sweep.ZIndex = 2
local sg = Instance.new("UIGradient", sweep)
sg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })

do
	local face = drawGengarFace(gui, 100, 64, Vector2.new(0.5, 0), UDim2.new(0, 20 + SIZE / 2, 0, 90))
	face.Name = "Banner"
	conns[#conns + 1] = RunService.Heartbeat:Connect(function() face.Visible = on end)
end
if GENGAR_IMAGE ~= "" then
	local img = Instance.new("ImageLabel", gui)
	img.Name = "Banner"; img.BackgroundTransparency = 1; img.Image = GENGAR_IMAGE; img.ScaleType = Enum.ScaleType.Fit
	img.Position = UDim2.new(0, 20, 0, 90); img.Size = UDim2.fromOffset(SIZE, 66)
	conns[#conns + 1] = RunService.Heartbeat:Connect(function() img.Visible = on end)
end

local tip = Instance.new("TextLabel", gui)
tip.Position = UDim2.new(0, 20, 0, TOP + SIZE + 6); tip.Size = UDim2.fromOffset(SIZE, 38)
tip.BackgroundColor3 = PANEL; tip.TextColor3 = TXT
tip.Font = Enum.Font.GothamMedium; tip.TextSize = 13; tip.Visible = false
Instance.new("UICorner", tip).CornerRadius = UDim.new(0, 8)
local tipStroke = Instance.new("UIStroke", tip)
tipStroke.Color = LINE; tipStroke.Thickness = 1
local hov

local function avatar(size, userId, z, color)
	local f = Instance.new("ImageLabel", disc)
	f.AnchorPoint = Vector2.new(0.5, 0.5); f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = RING; f.BorderSizePixel = 0; f.ZIndex = z
	f.Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
	Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
	local s = Instance.new("UIStroke", f)
	s.Color = color; s.Thickness = 1.5
	return f, s
end
avatar(28, lp.UserId, 3, Color3.fromRGB(150, 100, 230)).Position = UDim2.fromScale(0.5, 0.5)

local dots = {}
conns[#conns + 1] = Players.PlayerRemoving:Connect(function(p)
	if dots[p] then dots[p].f:Destroy(); dots[p] = nil end
end)

conns[#conns + 1] = UIS.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Semicolon and not UIS:GetFocusedTextBox() then
		on = not on; disc.Visible = on
	end
end)

conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
	angle = (angle + dt * 120) % 360
	sweep.Rotation = angle
	acc = acc + dt
	if acc < 0.05 then return end
	acc = 0
	disc.Visible = on
	if not on then tip.Visible = false end
	local cam = workspace.CurrentCamera
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not (on and cam and root) then return end
	local look = cam.CFrame.LookVector
	local f = Vector3.new(look.X, 0, look.Z)
	if f.Magnitude < 0.01 then return end
	f = f.Unit
	local right = Vector3.new(-f.Z, 0, f.X)
	for _, p in ipairs(Players:GetPlayers()) do
		local hrp = p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		local d, x, y, dist = dots[p], nil, nil, 0
		if hrp then
			local off = hrp.Position - root.Position
			dist = off.Magnitude
			x, y = off:Dot(right) / range * R, -off:Dot(f) / range * R
		end
		if x then
			if not d then
				local img, st = avatar(24, p.UserId, 2, Color3.fromRGB(150, 100, 230))
				img.Active = true
				img.MouseEnter:Connect(function() hov = p end)
				img.MouseLeave:Connect(function() if hov == p then hov = nil end end)
				d = { f = img, s = st }
				dots[p] = d
			end
			local m, lim = math.sqrt(x * x + y * y), R - 12
			if m > lim then x, y = x / m * lim, y / m * lim end
			d.f.ImageTransparency = m > lim and 0.45 or 0
			d.s.Color = dist < 150 and EYE or Color3.fromRGB(150, 100, 230)
			d.f.Position = UDim2.new(0.5, x, 0.5, y); d.f.Visible = true
		elseif d then
			d.f.Visible = false
		end
	end
	local hh = hov and hov.Character and hov.Character:FindFirstChild("HumanoidRootPart")
	tip.Visible = hh ~= nil
	if hh then
		local ps = hh.Position
		tip.Text = string.format("%s\nX %d   Y %d   Z %d   (%dm)", hov.Name, ps.X, ps.Y, ps.Z, (ps - root.Position).Magnitude)
	end
end)

env.GengarRadarCleanup = function()
	for _, c in ipairs(conns) do c:Disconnect() end
	gui:Destroy()
end
return function(v)
	on = v and true or false
	disc.Visible = on
	if not on then tip.Visible = false end
end
